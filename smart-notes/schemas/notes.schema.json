{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authored lecture notes",
  "type": "object",
  "additionalProperties": false,
  "required": ["mode", "overview", "visual_status", "sections"],
  "properties": {
    "mode": {"enum": ["notes", "detailed", "exam-review", "concepts", "quick"]},
    "source_language": {"$ref": "#/$defs/text"},
    "output_language": {"$ref": "#/$defs/text"},
    "overview": {"$ref": "#/$defs/text"},
    "visual_status": {"$ref": "#/$defs/text"},
    "warnings": {"$ref": "#/$defs/textList"},
    "key_concepts": {"$ref": "#/$defs/textList"},
    "review_points": {"$ref": "#/$defs/textList"},
    "sections": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/section"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "textList": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "summary"],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "summary": {"$ref": "#/$defs/text"},
        "key_ideas": {"$ref": "#/$defs/textList"},
        "definitions": {"$ref": "#/$defs/textList"},
        "equations": {"$ref": "#/$defs/textList"},
        "examples": {"$ref": "#/$defs/textList"},
        "instructor_intuition": {"$ref": "#/$defs/textList"},
        "common_mistakes": {"$ref": "#/$defs/textList"},
        "added_explanations": {"$ref": "#/$defs/textList"},
        "uncertainties": {"$ref": "#/$defs/textList"}
      }
    }
  }
}
